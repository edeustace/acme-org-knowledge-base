context = [ "## Decisions" ]
author = "mei"
created = 2026-08-07T10:15:00.000Z
status = "open"
text = "Do we need to say how workers get deployed, or is \"same repo, same container,\ndifferent entrypoint\" enough for the first cut? Decision 1 suggests we deliberately\ndon't want a separate worker fleet.\n"

[[comments.replies]]
author = "ede"
created = 2026-08-07T11:00:00.000Z
text = "Good catch — same container, `--role=worker` entrypoint. I'll add a line to the Architecture section."

